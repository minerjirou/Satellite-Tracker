{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "satellite-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",

  // 静的アセット(Vite の出力)を配信しつつ、/api/* だけ Worker を先に走らせる
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 軌道要素(OMM)とグループ所属の置き場。
  // 中身を書くのは GitHub Actions で、この Worker は読むだけ
  // (CelesTrak が Cloudflare の egress からの大量転送を絞っているため)。
  "kv_namespaces": [
    {
      "binding": "SATCACHE",
      "id": "ee050ee0c16140f3ac20ddfb72417e2f"
    }
  ],

  "observability": {
    "enabled": true
  }
}
